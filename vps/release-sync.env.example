# Copy to /etc/tiktok-analyzer/release-sync.env and chmod 0600.
RELEASE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
RELEASE_R2_BUCKET=<private-bucket>
RELEASE_R2_REGION=auto
RELEASE_R2_PREFIX=releases/
RELEASE_R2_READ_ACCESS_KEY_ID=<read-only-key>
RELEASE_R2_READ_SECRET_ACCESS_KEY=<read-only-secret>
RELEASE_SYNC_RELEASE_ROOT=/srv/tiktok-analyzer/releases
RELEASE_SYNC_MEDIA_ROOT=/srv/tiktok-analyzer/media
RELEASE_SYNC_STATE_ROOT=/var/lib/tiktok-analyzer/release-sync
RELEASE_ACTIVATE_RELOAD_COMMAND=docker compose --env-file /home/projects/tiktok-analyzer/.env.prod -f /home/projects/tiktok-analyzer/docker-compose.prod.yml up -d --no-deps tiktok-analyzer
RELEASE_ACTIVATE_EXTERNAL_URL=https://<hub-host>/hub
# RELEASE_ACTIVATE_ACTIVE_PATH=/var/lib/tiktok-analyzer/release-sync/active-release
# RELEASE_ACTIVATE_PREVIOUS_PATH=/var/lib/tiktok-analyzer/release-sync/previous-release
# RELEASE_SYNC_NOTIFY_COMMAND=/usr/local/sbin/tiktok-release-sync-notify
