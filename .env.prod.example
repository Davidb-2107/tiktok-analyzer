# ─── Production environment template ─────────────────────────────────────
# Copy to .env.prod on the VPS and fill in the real R2 credentials.
# .env.prod itself is git-ignored.

# CORS: same-origin in prod (Cloudflare Tunnel terminates at the container)
ALLOWED_ORIGIN=https://tiktok-analyzer.hen8n.com

# Cloudflare R2 storage for frames
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tiktok-analyzer-frames
R2_ENDPOINT=

# Concurrency cap on background jobs (jobs beyond this QUEUE as "pending")
MAX_CONCURRENT_JOBS=2
# Backlog cap: /analyze returns 429 only once this many jobs are non-terminal
MAX_PENDING_JOBS=20

# Input guards for the public /analyze endpoint
# Shared secret: when set, POST/DELETE require header `X-API-Key: <key>` (GET stays
# open). Leave empty to keep the endpoint fully open. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Host allowlist (subdomains allowed). Empty value disables the check.
ALLOWED_VIDEO_DOMAINS=tiktok.com,youtube.com,youtu.be
# Reject videos longer than this many seconds (probed before download). 0 disables.
MAX_VIDEO_DURATION_SEC=600
# Looser cap for transcribe=false jobs (frames+OCR only, no Whisper) — long
# YouTube masters for the Sourcing review funnel. 0 disables.
MAX_NOTRANSCRIBE_DURATION_SEC=1800

# Local Whisper (faster-whisper) — VPS is CPU-only on Contabo
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Beam search width. 5 = faster-whisper default (~30-40% faster than 10 on CPU,
# marginal quality difference). Raise to 10 for hard audio if transcripts degrade.
WHISPER_BEAM_SIZE=5

# OCR of on-screen overlay text (RapidOCR, PP-OCRv5 latin). ONNX intra-op threads
# per job; 2 jobs max in parallel + Whisper on 8 vCPU -> keep small.
OCR_THREADS=2

# Hook microscope: denser OCR pass over the opening seconds (catches overlay
# captions that flash <1s and are missed by the main pass).
HOOK_WINDOW_S=5
HOOK_FPS=2

# Frame density used when a caller requests a start_s/end_s window on /analyze.
WINDOW_FPS=2

# Per-project inbox routing (paths inside the container; bind-mount as needed).
# Leave INBOX_PSYCHO empty unless you also mount a host folder into the
# container — without Obsidian on the VPS, transcripts stay in temp/{id}/
# and are reachable via GET /jobs/{id}/script.txt.
SCRIPT_INBOX_DIR=
INBOX_PSYCHO=
INBOX_ARCHIVE=
